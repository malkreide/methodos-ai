{
  "$defs": {
    "Asset": {
      "description": "Supporting material for a method: a template, a board, a slide deck.\n\nExactly one of `path` and `url`. A `path` is a file shipped in this\nrepository under `methods/assets/<Id>/`; a `url` points elsewhere. Premium\nassets must use `url` \u2014 see AssetAccess.",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "access": {
          "$ref": "#/$defs/AssetAccess",
          "default": "open"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        }
      },
      "required": [
        "title",
        "kind"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetAccess": {
      "description": "Who may use an asset.\n\n`open` assets are part of the public catalog. `premium` assets are not: the\ncatalog only *points* at them, and the file itself lives wherever it is\nsold or licensed \u2014 never in this repository, which is public.",
      "enum": [
        "open",
        "premium"
      ],
      "title": "AssetAccess",
      "type": "string"
    },
    "AssetKind": {
      "enum": [
        "template",
        "worksheet",
        "slides",
        "board",
        "checklist",
        "video",
        "other"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "Category": {
      "description": "Coarse-grained categorization of methods.\n\nAdding a category is a non-breaking schema change; bump `schema_version`\nonly when a *required* field changes.",
      "enum": [
        "strategy",
        "decision-making",
        "analysis",
        "prioritization",
        "retrospective",
        "facilitation",
        "change-management"
      ],
      "title": "Category",
      "type": "string"
    },
    "Context": {
      "description": "The kind of organisation a method has been shown to work in.\n\nDeliberately coarse: it answers \"is this for us at all?\", not \"which\ndepartment\". Finer distinctions belong in `use_cases`, where the search\ncan see them.",
      "enum": [
        "business",
        "public-sector",
        "education",
        "nonprofit",
        "personal"
      ],
      "title": "Context",
      "type": "string"
    },
    "Duration": {
      "description": "Estimated wall-clock time to apply the method end-to-end.",
      "properties": {
        "min_minutes": {
          "maximum": 10000,
          "minimum": 5,
          "title": "Min Minutes",
          "type": "integer"
        },
        "max_minutes": {
          "maximum": 10000,
          "minimum": 5,
          "title": "Max Minutes",
          "type": "integer"
        }
      },
      "required": [
        "min_minutes",
        "max_minutes"
      ],
      "title": "Duration",
      "type": "object"
    },
    "Format": {
      "description": "How the method can be run.",
      "enum": [
        "in-person",
        "hybrid",
        "remote",
        "async"
      ],
      "title": "Format",
      "type": "string"
    },
    "GroupSize": {
      "description": "How many participants the method works for.",
      "properties": {
        "min_people": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Min People",
          "type": "integer"
        },
        "max_people": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max People",
          "type": "integer"
        }
      },
      "required": [
        "min_people",
        "max_people"
      ],
      "title": "GroupSize",
      "type": "object"
    }
  },
  "description": "A management method as represented in the catalog.\n\nThe `use_case` field is the text we embed for retrieval. All other fields\nare surfaced to the user via CLI rendering or filtering. Adding a new\nfield that is *not* required is non-breaking; adding a required field\nbumps `schema_version` and requires a migration of existing JSON files.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[A-Z][A-Za-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "use_case": {
      "minLength": 40,
      "title": "Use Case",
      "type": "string"
    },
    "use_cases": {
      "items": {
        "minLength": 40,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Use Cases",
      "type": "array"
    },
    "strengths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Strengths",
      "type": "array"
    },
    "weaknesses": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Weaknesses",
      "type": "array"
    },
    "complexity_score": {
      "maximum": 5,
      "minimum": 1,
      "title": "Complexity Score",
      "type": "integer"
    },
    "estimated_duration": {
      "$ref": "#/$defs/Duration"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    },
    "contexts": {
      "items": {
        "$ref": "#/$defs/Context"
      },
      "title": "Contexts",
      "type": "array"
    },
    "formats": {
      "items": {
        "$ref": "#/$defs/Format"
      },
      "title": "Formats",
      "type": "array"
    },
    "group_size": {
      "anyOf": [
        {
          "$ref": "#/$defs/GroupSize"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "audience": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "title": "Audience",
      "type": "array"
    },
    "language": {
      "default": "en",
      "pattern": "^[a-z]{2}$",
      "title": "Language",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "owner": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "last_reviewed": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Reviewed"
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "use_case",
    "strengths",
    "weaknesses",
    "complexity_score",
    "estimated_duration"
  ],
  "title": "Method",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Malkreide/methodos-ai/blob/main/schemas/method_schema.json"
}
