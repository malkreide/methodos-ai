# Copy to .env. Read by the CLI, the MCP server, the HTTP API, and — for the
# ${...} substitutions in docker-compose.yml — by Docker Compose itself.

# ---------------------------------------------------------------------------
# LLM for the explain step
# ---------------------------------------------------------------------------
# Anthropic is the recommended cloud backend and the default for the container.
# ANTHROPIC_API_KEY=sk-ant-...
# METHODOS_MODEL=anthropic/claude-opus-5
#
# Cheaper and faster, at some cost in the quality of the comparison prose:
# METHODOS_MODEL=anthropic/claude-haiku-4-5
#
# Any other litellm-supported provider works the same way — one env var for the
# model, one for that provider's key:
# METHODOS_MODEL=openai/gpt-4o-mini        + OPENAI_API_KEY=sk-...
# METHODOS_MODEL=ollama/llama3.1:8b        (local, the library default)

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Embeddings are local by default (sentence-transformers). Anthropic has no
# embedding endpoint, so a cloud LLM does not remove this dependency; switching
# to OpenAI embeddings is the only way to drop it, and needs OPENAI_API_KEY.
# METHODOS_EMBEDDING_PROVIDER=openai
# METHODOS_EMBEDDING_MODEL=text-embedding-3-small

# Cross-encoder rerank of the shortlist is ON by default. Turn it off with:
# METHODOS_RERANK_PROVIDER=none
# METHODOS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#
# It needs the `local` extra. Without it, queries still work — reranking is
# skipped and reported, rather than failing the query.

# Shortlist length as a multiple of top_k. Buys nothing on the current
# catalog; worth raising as it grows. Cost is linear.
# METHODOS_OVERFETCH_FACTOR=2

# How many methods a query returns by default.
# METHODOS_TOP_K=3

# ---------------------------------------------------------------------------
# Paths — set these when the process is started from another directory, which
# an MCP client and a container both do.
# ---------------------------------------------------------------------------
# METHODOS_METHODS_DIR=/abs/path/to/methods
# METHODOS_CHROMA_PATH=/abs/path/to/data/chroma
# METHODOS_FEEDBACK_PATH=/abs/path/to/data/feedback.jsonl

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
# Host port for the HTTP service.
# METHODOS_PORT=8000
