# Pick one cloud LLM (or leave blank to use the local Ollama default)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Override the default model:
# METHODOS_MODEL=anthropic/claude-3-5-haiku-20241022
# METHODOS_MODEL=openai/gpt-4o-mini
# METHODOS_MODEL=ollama/llama3.1:8b

# Optional: switch embedding provider to OpenAI (default: local sentence-transformers)
# METHODOS_EMBEDDING_PROVIDER=openai
# METHODOS_EMBEDDING_MODEL=text-embedding-3-small

# Optional: cross-encoder rerank of the shortlist (default: off).
# Needs the `local` extra; downloads ~80MB on first use.
# METHODOS_RERANK_PROVIDER=cross-encoder
# METHODOS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# How many candidates Chroma returns per requested result. Only worth raising
# when reranking is on — it gives the cross-encoder a longer shortlist.
# METHODOS_OVERFETCH_FACTOR=4
